# ---------------------------------------------------------------------------
# universal-bot-nest — example environment
#
# Copy to `.env` and fill in real values:   cp .env.example .env
# `.env` is git-ignored. Never commit real tokens, IDs, or passwords.
#
# Validation happens at boot (Joi, src/config/config.scheme.ts).
# Unknown variables are allowed and ignored.
# Variables appear here in the same order as the README configuration table.
# ---------------------------------------------------------------------------

# --- Runtime -----------------------------------------------------------------
# NODE_ENV: development | production | test   (default: development)
# Also decides the default strictness of the startup dependency checks.
NODE_ENV=development
# HTTP port for GET /health and the Bull Board dashboard (default: 3000)
PORT=3000

# --- Telegram bot (required) -------------------------------------------------
# Bot token issued by @BotFather. The app refuses to boot without it.
BOT_TOKEN=your-telegram-bot-token
# Numeric Telegram user id allowed to run /bc (broadcast) — yours, not the bot's.
# Non-admin callers are ignored silently.
ADMIN_ID=000000000

# --- Telegram Bot API endpoint (optional) ------------------------------------
# Leave false to use the public https://api.telegram.org (~50MB upload cap).
# Set true to route through a self-hosted Bot API server for larger uploads.
# Accepts true/false/1/0.
USE_LOCAL_BOT_API=false
# Base URL of the self-hosted Bot API server.
# REQUIRED when USE_LOCAL_BOT_API=true; must be a valid http/https URL.
# Example for the bundled docker compose file: http://127.0.0.1:8081
TELEGRAM_API_ROOT=

# --- MongoDB (required) ------------------------------------------------------
# Stores users and the Telegram file_id cache.
# In production, pull credentials from a secret store — never commit a URI
# that contains a password.
MONGODB_URI=mongodb://localhost:27017/universal_bot_nest

# --- Redis (Bull queues, YouTube URL cache, rate limiter) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Leave empty when Redis has no auth configured.
REDIS_PASSWORD=

# --- Media cache & storage ---------------------------------------------------
# Days a cached file_id is kept, via a MongoDB TTL index (default: 30).
# The index is created at model registration — changing this later requires
# recreating the index by hand.
CACHE_DAYS=30
# Upload ceiling in bytes. 52428800 = 50MB, the public Bot API limit.
# Enforced twice: passed to yt-dlp as --max-filesize and rechecked before
# upload. Raise it only when USE_LOCAL_BOT_API=true.
MAX_FILE_SIZE=52428800
# Working directory for temporary downloads; created at startup if missing.
# Relative paths are resolved from the process working directory.
DOWNLOAD_DIR=downloads

# --- Throughput & abuse control ----------------------------------------------
# Concurrent jobs handled by the download worker (default: 10, integer >= 1).
# Read once at module load time.
DOWNLOAD_WORKER_CONCURRENCY=10
# Fresh downloads one user may start per window (default: 3, integer >= 1).
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=3
# Length of the rate-limit window in seconds (default: 30, integer >= 1).
DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=30

# --- Startup dependency checks (optional) ------------------------------------
# Controls whether a failed dependency check aborts boot.
# Unset: strict in production, lenient in development/test.
# When lenient, the app starts degraded and reports it on GET /health.
# STARTUP_STRICT_DEPENDENCY_CHECKS=true

# --- Bull Board dashboard (optional) -----------------------------------------
# /admin/queues is DISABLED unless BOTH are set to non-empty values — Joi
# enforces the pair, and the route is not mounted at all if either is missing.
# They back HTTP Basic auth, so pick a strong password.
BULL_BOARD_USERNAME=
BULL_BOARD_PASSWORD=

# --- Self-hosted Telegram Bot API container (Docker only) --------------------
# Consumed by docker/telegram-bot-api/docker-compose.yml, NOT by the Nest app.
# Compose reads its own .env next to the compose file, so either copy these
# two lines there or run: docker compose --env-file ../../.env up -d
# Obtain both from https://my.telegram.org -> API Development Tools.
# Only needed when you run your own Bot API server.
TELEGRAM_API_ID=your-telegram-api-id
TELEGRAM_API_HASH=your-telegram-api-hash
