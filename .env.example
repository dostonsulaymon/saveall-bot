NODE_ENV=development
PORT=4554

BOT_TOKEN=d:ds

ADMIN_ID=ds
USE_LOCAL_BOT_API=false
TELEGRAM_API_ROOT=

MONGODB_URI=sdds

TELEGRAM_API_ID=sd
TELEGRAM_API_HASH=sds

CACHE_DAYS=30
# bytes (50MB for public Bot API)
MAX_FILE_SIZE=52428800
DOWNLOAD_DIR=downloads

REDIS_HOST=localhost
REDIS_PORT=6379
# Optional override:
# - default is strict in production
# - default is non-strict in development/test
# STARTUP_STRICT_DEPENDENCY_CHECKS=true
DOWNLOAD_RATE_LIMIT_MAX_REQUESTS=3
DOWNLOAD_RATE_LIMIT_WINDOW_SECONDS=30
